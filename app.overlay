
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>

/ {
    chosen {
        zephyr,display = &st7735r_128x128;
    };

    mipi_dbi {
        compatible = "zephyr,mipi-dbi-spi";
        spi-dev = <&spi0>;
        
        dc-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
        #address-cells = <1>;
        #size-cells = <0>;

        st7735r_128x128: st7735r@0 {
            compatible = "sitronix,st7735r";
            reg = <0>;
            
            mipi-max-frequency = <32000000>;
            mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
            
            width = <128>;
            height = <128>;
            x-offset = <2>;
            y-offset = <3>; 
            
            madctl = <0xc0>;
            colmod = <0x05>;
            vmctr1 = <0x0e>;
            pwctr1 = [a2 02 84];
            pwctr2 = [c5];
            pwctr3 = [0a 00];
            pwctr4 = [8a 2a];
            pwctr5 = [8a ee];
            frmctr1 = [01 2c 2d];
            frmctr2 = [01 2c 2d];
            frmctr3 = [01 2c 2d 01 2c 2d];
            
            gamctrp1 = [02 1c 07 12 37 32 29 2d 29 25 2b 39 00 01 03 10];
            gamctrn1 = [03 1d 07 06 2e 2c 29 2d 2e 2e 37 3f 00 00 02 10];
        };
    };

};

&spi0 {
    pinctrl-0 = <&spi0_default>;
    status = "okay";
    cs-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
};

&pinctrl {
    spi0_custom_pins: spi0_default {
        group1 {
            pinmux = <SPI0_TX_P3>;
        };

        group3 {
            pinmux = <SPI0_SCK_P2>;
        };
    };
};
